{
  "name": "radio-news-monorepo",
  "version": "1.0.0",
  "private": true,
  "description": "Radio News monorepo: podcast-player UI + newstask worker, sharing the news pipeline package",
  "packageManager": "pnpm@10.33.2",
  "scripts": {
    "dev": "pnpm --filter podcast-player dev",
    "build": "pnpm --filter podcast-player build",
    "start": "pnpm --filter podcast-player start",
    "pipeline": "pnpm --filter @radio-news/pipeline pipeline",
    "build:scripts": "pnpm --filter @radio-news/pipeline build:scripts",
    "crawl": "pnpm --filter @radio-news/pipeline crawl",
    "scenario": "pnpm --filter @radio-news/pipeline scenario",
    "news:build": "pnpm --filter @radio-news/pipeline build"
  },
  "pnpm": {
    "onlyBuiltDependencies": [
      "esbuild"
    ]
  }
}
