{
  "name": "radio-news",
  "version": "1.0.0",
  "description": "Radio News: Next.js player + news auto-production pipeline",
  "private": true,
  "type": "module",
  "scripts": {
    "dev": "next dev",
    "build": "next build",
    "start": "next start",
    "lint": "next lint",
    "pipeline": "node --env-file=.env scripts/run_pipeline.ts",
    "build:scripts": "tsc -p tsconfig.scripts.json",
    "news:crawl": "node scripts/khu_crawler.ts",
    "news:scenario": "node scripts/scenarist.ts",
    "news:build": "node scripts/news_builder.ts"
  },
  "dependencies": {
    "@google/generative-ai": "^0.24.1",
    "next": "^14.0.0",
    "node-cron": "^4.6.0",
    "openai": "^4.78.0",
    "playwright": "^1.63.0",
    "react": "^18.2.0",
    "react-dom": "^18.2.0"
  },
  "devDependencies": {
    "@opencode-ai/sdk": "^1.18.16",
    "@types/node": "^20.0.0",
    "@types/react": "^18.2.0",
    "tsx": "^4.23.12",
    "typescript": "^5.3.0"
  },
  "pnpm": {
    "onlyBuiltDependencies": [
      "esbuild"
    ]
  }
}
