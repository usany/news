{
  "name": "radio-news",
  "version": "1.0.0",
  "description": "Radio News: Next.js player + news auto-production pipeline",
  "private": true,
  "type": "module",
  "scripts": {
    "dev": "concurrently -n next,server -c cyan,magenta \"next dev\" \"pnpm --dir server run start:dev\"",
    "dev:client": "next dev",
    "dev:server": "pnpm --dir server run start:dev",
    "build": "next build",
    "start": "next start",
    "pipeline": "node --env-file=.env scripts/run_pipeline.ts",
    "news:crawl": "node --env-file=.env scripts/khu_crawler.ts",
    "news:scenario": "node --env-file=.env scripts/scenarist.ts",
    "news:build": "node --env-file=.env scripts/news_builder.ts"
  },
  "dependencies": {
    "@google/generative-ai": "^0.24.1",
    "next": "^15.5.28",
    "node-cron": "^4.6.0",
    "openai": "^4.78.0",
    "playwright": "^1.63.0",
    "react": "^18.2.0",
    "react-dom": "^18.2.0"
  },
  "devDependencies": {
    "@opencode-ai/sdk": "^1.18.16",
    "@types/node": "^20.19.43",
    "@types/react": "^18.2.0",
    "concurrently": "^10.0.6",
    "typescript": "^5.3.0"
  },
  "pnpm": {
    "onlyBuiltDependencies": [
      "esbuild"
    ]
  }
}
