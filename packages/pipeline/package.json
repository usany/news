{
  "name": "@radio-news/pipeline",
  "version": "1.0.0",
  "description": "Shared news pipeline scripts (crawl -> scenario -> TTS) for the Radio News monorepo",
  "private": true,
  "type": "module",
  "scripts": {
    "build:scripts": "tsc -p tsconfig.scripts.json",
    "pipeline": "node --env-file=.env scripts/run_pipeline.ts",
    "crawl": "tsx scripts/khu_crawler.ts",
    "scenario": "tsx scripts/scenarist.ts",
    "build": "tsx scripts/news_builder.ts"
  },
  "dependencies": {
    "openai": "^4.78.0",
    "playwright": "^1.63.0"
  },
  "devDependencies": {
    "@types/node": "^26.6.4",
    "tsx": "^4.23.15",
    "typescript": "^7.0.2"
  }
}
